# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which will thus
# fall under /target given that is the default compile directory,
# but if you have a custom compile directory they will be generated there.
*.pdb

# JetBrains IDEs / VSCode settings
.idea/
.vscode/

# Environment Variables
.env
